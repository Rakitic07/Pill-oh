{
  "name": "pill-oh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && node scripts/vercel-output.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "make-admin": "node --env-file-if-exists=.env server/scripts/make-admin.ts",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
