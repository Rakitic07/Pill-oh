# Copy this file to `.env` (never commit `.env`).

# Neon / Postgres connection string from the Neon console (Dashboard → Connect).
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Leave empty to run fully locally with a JSON file store at server/.data/local-db.json.
DATABASE_URL=

# Port for the API server (Vite proxies /api to it in development).
PORT=8787

# Public address of the deployed app, used for link-preview thumbnails (WhatsApp, iMessage…).
# Set before `npm run build`, e.g. https://pill-oh.example.com (no trailing slash).
SITE_URL=

# Optional: create the first admin on startup (use "Admin login" in the page footer).
# If the username already exists it is just promoted to admin; its password is not changed.
# Choose your own strong password (8+ chars). Never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Phone push notifications (Web Push) ---
# Optional locally: if empty, a key pair is generated once into server/.data/vapid.json.
# In production set them so phones stay subscribed across redeploys. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# --- ntfy (free per-user alerts via the ntfy app on iPhone/Android) ---
# Works out of the box with the public https://ntfy.sh. Only change for a self-hosted server.
NTFY_SERVER=
# Access token, only for a self-hosted ntfy server with access control.
NTFY_TOKEN=

# --- WhatsApp alerts via Twilio (optional; WhatsApp stays hidden until all three are set) ---
# From the Twilio console. Sandbox sender looks like whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Outside the sandbox, WhatsApp requires Meta-approved templates for messages you start.
# Reminder template variables: {{1}} medicines, {{2}} time. Code template: {{1}} 6-digit code.
TWILIO_REMINDER_CONTENT_SID=
TWILIO_CODE_CONTENT_SID=

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For (automatic on Vercel).
TRUST_PROXY=0

# --- Serverless hosts (Vercel) ---
# Long random value; a scheduler calls GET /api/cron/notify every minute with
# "Authorization: Bearer <CRON_SECRET>" to send reminders. Generate with: openssl rand -hex 32
CRON_SECRET=
